<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <application
        android:name="io.github.zenthxsin.rustwright.platform.android.RwApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="Workbench"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/WorkbenchTheme">
        <activity
            android:name="io.github.workbench.MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection|colorMode|touchscreen|mcc|mnc|fontWeightAdjustment|grammaticalGender"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="workbench" android:host="login" />
            </intent-filter>
        </activity>
    </application>
</manifest>
